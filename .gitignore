# Local env
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
.claude/settings.local.json
.claude/scheduled_tasks.lock
# Agent-loop scratch clones. Nested git worktrees, each a full copy of this repo — they must
# never be enumerated as this repo's own files. Was only in .git/info/exclude, so a fresh clone
# and CI did not have it.
.claude/worktrees/
# Same thing for kosho's scratch clones. `.kosho/.gitignore` is anchored to its own directory and
# guards a different copy, so the rule is declared here too. Untracked agent worktrees becoming
# git-visible is how a private checkout leaks.
.kosho/worktrees/
.kosho/hooks/*.sample

# Secrets / keys — belt-and-suspenders on top of .env
*.pem
*.key
id_rsa*
*.log
.local/
.cache/

# Python bytecode
__pycache__/
*.pyc

# Java / Maven — glob covers the reactor modules (backend/target, backend/app/target, …)
backend/**/target/
*.class
hs_err_pid*.log

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/coverage/
# pnpm keeps its content-addressable store globally (~/Library/pnpm/store on macOS), which is what
# makes a second worktree cost ~nothing. Guard against anyone pointing it inside the repo instead.
.pnpm-store/

# Crew
.crew/

# Database dumps
*.sql.gz

# GTM / go-to-market working files (leads, outreach drafts, scraped threads) — never committed
gtm/

# Design working files: .dc.html mockups and the published canvases they seed.
# The canvases are ~2 MB each and mostly a minified editor bundle, so a design
# exploration costs more diff than the feature it explores. Regenerate, don't commit.
.design/
.design-sketches/

# The load harness mints live write-scoped tokens and writes its runs beside itself.
scripts/bench/tokens.txt
scripts/bench/results/

# Coverage outputs (frontend/coverage/ sits with the frontend rules above).
.coverage
