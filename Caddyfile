# Dev reverse proxy for `task caddy` (localhost defaults) and docker-compose.dev.yml (service names).
# Backend paths go to the backend; everything else goes to the Vite dev server.
# Validate: caddy validate --config Caddyfile
{
	admin off
}

:8000 {
	log {
		output stdout
		format console
	}

	@backend {
		path /api/* /auth/* /mcp /mcp/* /git/github/callback /git/github/manifest/callback /v1/traces /v1/query/* /v1/usage/* /actuator/health
	}
	handle @backend {
		reverse_proxy {$BACKEND_URL:localhost:8080}
	}

	handle {
		reverse_proxy {$FRONTEND_URL:localhost:5173}
	}
}
