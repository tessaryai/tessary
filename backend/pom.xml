<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Reactor aggregator for the Maven multi-module skeleton. The Spring Boot app lives in the `app`
      module; `shared` and `contract` are OPEN modules (cleanly extractable, no dependency on the app
      or any closed module — enforced by bannedDependencies in each module's pom). Spring Boot's
      dependency/plugin management is inherited from spring-boot-starter-parent here and flows to
      every module.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>ai.tessary</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>shared</module>
        <module>contract</module>
        <module>core</module>
        <module>test-support</module>
        <module>tenancy</module>
        <module>substrate</module>
        <module>product</module>
        <module>llm-runtime</module>
        <module>analysis</module>
        <module>surfaces</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!-- Formatting toolchain (build-time only; never on the runtime classpath). Declared here
             rather than in `app` because Spotless is bound for EVERY module below. -->
        <spotless.version>3.10.4</spotless.version>
        <palantir-java-format.version>2.91.0</palantir-java-format.version>
        <docker.api.version>1.44</docker.api.version>
        <error-prone.version>2.50.0</error-prone.version>
        <forbiddenapis.version>3.11</forbiddenapis.version>
        <nullaway.version>0.14.2</nullaway.version>
        <spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
        <spotbugs.version>4.10.5</spotbugs.version>
        <findsecbugs.version>1.14.0</findsecbugs.version>
        <awssdk.version>2.57.0</awssdk.version>
        <grpc.version>1.85.1</grpc.version>
        <!-- CVE-2026-110879 (GHSA-m8xf-2cr7-77ph): spring-boot-starter-parent:4.1.2's BOM pins
             Jackson to 2.21.7 and 3.1.7. Override ahead of Boot's own BOM; remove both once that
             BOM catches up to >=2.21.8 and >=3.1.8. -->
        <jackson-2-bom.version>2.21.8</jackson-2-bom.version>
        <jackson-bom.version>3.1.8</jackson-bom.version>
        <!-- PDF text extraction for the document/PDF modality: pure-Java,
             Apache-2.0, no native binaries and no network egress — safe for the open bucket.
             Verified latest stable 3.x on Maven Central 2026-09-02. NOT covered by CI (
             scripts/check-dependency-audit.sh is on-demand-only, per its own header) — a bad license
             choice here would not be caught automatically; this note is the record that the license
             was checked by hand at introduction time. -->
        <pdfbox.version>3.0.8</pdfbox.version>
        <opentelemetry-instrumentation.version>2.32.0-alpha</opentelemetry-instrumentation.version>
        <protobuf-java.version>4.36.2</protobuf-java.version>
        <!-- Testcontainers 2.x: the artifacts were regrouped, so the modules depend on
             `testcontainers-postgresql` / `testcontainers-junit-jupiter`, NOT the 1.x
             `postgresql` / `junit-jupiter` names. Docker is required to run `mvn verify`. -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <archunit.version>1.5.1</archunit.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <!-- Empty, not unset: a module without jacoco:prepare-agent must still resolve ${argLine}. -->
        <argLine></argLine>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- AWS SDK v2 BOM: single source of truth for every awssdk module, so they never
                 drift apart on a shared transitive like aws-core. -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- alpha BOM, not the stable one — the Logback appender is still
                 versioned under -alpha even though the artifact itself has been
                 production-ready for years. -->
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-bom-alpha</artifactId>
                <version>${opentelemetry-instrumentation.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- gRPC BOM: pins grpc-netty-shaded / grpc-protobuf / grpc-stub (the OTLP/gRPC receiver)
                 to one version. Unmanaged by the Spring Boot 4 BOM, so imported here. -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Lock protobuf-java to the version opentelemetry-proto resolves (4.x). grpc-protobuf
                 declares an older 3.25.x floor; this pin keeps the runtime protobuf single-versioned so
                 the gRPC stub and the OTLP message types share one protobuf-java. -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf-java.version}</version>
            </dependency>
            <!-- Swagger annotations (@Operation, @Schema) used directly by controllers and DTOs.
                 They arrive transitively via springdoc, but a module that only annotates - rather
                 than configures OpenAPI - depends on the annotations alone, so the version is pinned
                 here to the one springdoc resolves rather than left to whichever module wins.

                 HELD at 2.2.47. 2.2.53 emits `"default": ""` on 26 enum and array-item schemas that
                 have no such default, which is wrong API documentation and rides into every
                 generated client as a bogus `@default` JSDoc tag. No type changes - purely a
                 fidelity regression in a contract we publish. Re-check on the next release; the
                 test for it is `task contract:openapi` followed by grepping the spec for
                 `"default": ""`. -->
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>2.2.55</version>
            </dependency>
            <!-- JSpecify nullness annotations (@Nullable) - the contract NullAway checks.
                 Managed here so the modules that use it cannot drift to different versions. -->
            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>1.0.1</version>
            </dependency>
            <!-- CVE-2026-106451: kafka-clients 4.2.2 (Boot 4.1.2's kafka) declares lz4-java 1.11.2,
                 and the Boot BOM does not manage it. Remove once kafka-clients declares >=1.11.4. -->
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>1.12.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <!-- The shared quality gate; a module activates a plugin by naming it with no configuration. -->
            <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- docker-java defaults to API 1.32, which Docker Engine 25+ rejects with HTTP 400. -->
                    <systemPropertyVariables>
                        <api.version>${docker.api.version}</api.version>
                    </systemPropertyVariables>
                    <!-- Without this surefire ignores jacoco's agent and coverage is silently 0%. -->
                    <argLine>${argLine}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                    <compilerArgs>
                        <arg>-XDcompilePolicy=simple</arg>
                        <arg>--should-stop=ifError=FLOW</arg>
                        <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                        <!-- NotJavadoc: records/DTOs document components with block comments. JavaLangClash:
                             model/Runtime mirrors the synth-schema name (contract-driven).
                             NullAway covers 18 open packages; widen
                             AnnotatedPackages one package at a time and run the gate — a package
                             that is not listed is NOT checked, and a name that matches nothing is
                             silently ignored, so keep this list honest.
                             Still outside the set: alert, billing, ci, config, detection, edition, gate, git, llm, llmspi, metering, model, onboarding, ops, plan, pricing, prompt, query, rca, redaction, retention, search, storage, telemetry, tenant, traces, usage. -->
                        <arg>-Xplugin:ErrorProne -Xep:NotJavadoc:OFF -Xep:JavaLangClash:OFF -Xep:NullAway:ERROR -XepOpt:NullAway:AnnotatedPackages=ai.tessary.open.errors,ai.tessary.open.obs,ai.tessary.apidoc,ai.tessary.crypto,ai.tessary.version,ai.tessary.web,ai.tessary.mcp,ai.tessary.sources,ai.tessary.auth,ai.tessary.ingest,ai.tessary.db,ai.tessary.pipeline,ai.tessary.sandbox,ai.tessary.classifier,ai.tessary.featureflags,ai.tessary.cases,ai.tessary.agentrun,ai.tessary.metrics</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${error-prone.version}</version>
                        </path>
                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>${nullaway.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>de.thetaphi</groupId>
                <artifactId>forbiddenapis</artifactId>
                <version>${forbiddenapis.version}</version>
                <configuration>
                    <failOnUnsupportedJava>false</failOnUnsupportedJava>
                    <includes>
                        <include>ai/tessary/**</include>
                    </includes>
                    <bundledSignatures>
                        <bundledSignature>jdk-unsafe</bundledSignature>
                        <bundledSignature>jdk-non-portable</bundledSignature>
                        <bundledSignature>jdk-system-out</bundledSignature>
                    </bundledSignatures>
                </configuration>
                <executions>
                    <execution>
                        <id>forbidden-apis-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                            <goal>testCheck</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <configuration>
                    <effort>Default</effort>
                    <threshold>Low</threshold>
                    <includeTests>false</includeTests>
                    <sarifOutput>true</sarifOutput>
                    <excludeFilterFile>${project.basedir}/../config/spotbugs-exclude.xml</excludeFilterFile>
                    <onlyAnalyze>ai.tessary.-</onlyAnalyze>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugs.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs</artifactId>
                        <version>${spotbugs.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <propertyName>argLine</propertyName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- On the aggregator so the `spotless` prefix resolves for `mvn spotless:apply`; bound to
                 validate so a format slip fails before compile. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <palantirJavaFormat>
                            <version>${palantir-java-format.version}</version>
                        </palantirJavaFormat>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
