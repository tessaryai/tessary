{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://home.tessary.ai/contracts/ping.v1.schema.json",
  "title": "PingV1",
  "description": "Generated from services/ping/src/contract/v1.ts by `pnpm schema`. Do not edit by hand. additionalProperties is true because the handler strips unknown fields rather than rejecting them: inside a contract version, changes are additive only.",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "integer"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "ping_seq": {
      "type": "integer",
      "minimum": 0
    },
    "sent_at": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,9})?(Z|\\+00:00)$"
    },
    "app_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "edition": {
      "type": "string",
      "enum": [
        "open",
        "paid"
      ]
    },
    "deploy_mode": {
      "type": "string",
      "enum": [
        "compose",
        "k8s"
      ]
    },
    "os": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "arch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "counts": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "integer",
          "minimum": 0
        },
        "spans": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "cases": {
          "type": "integer",
          "minimum": 0
        },
        "l1": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "price_book": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "schema_max": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    }
  },
  "required": [
    "contract_version",
    "instance_id",
    "ping_seq",
    "sent_at",
    "app_version"
  ],
  "additionalProperties": true
}
