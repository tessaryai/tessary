'use strict';
/*
 * session.js run the way a launcher runs it: a real child over a real session.json, with
 * test/fixtures/fake-opencode on PATH as `opencode` playing `script`. No extension, so node --test
 * skips it. `secret: null` starts the child with no SESSION_SECRET at all; an `input` string is
 * written as session.json verbatim.
 */
const { spawn } = require('node:child_process');
const fs = require('node:fs');
const net = require('node:net');
const os = require('node:os');
const path = require('node:path');
const { makeFakeOpencodeBin } = require('./fake-opencode');

const SESSION_JS = path.join(__dirname, '..', '..', 'session.js');
const DEADLINE_MS = 5_000;
const tmp = (prefix) => fs.mkdtempSync(path.join(os.tmpdir(), prefix));

function freePort() {
  return new Promise((resolve, reject) => {
    const srv = net.createServer();
    srv.on('error', reject);
    srv.listen(0, '127.0.0.1', () => {
      const { port } = srv.address();
      srv.close(() => resolve(port));
    });
  });
}

async function startSession({ input = {}, script = { replies: [] }, env = {}, secret = 'a'.repeat(64) } = {}) {
  const workDir = tmp('session-work-');
  const recordDir = tmp('session-record-');
  const binDir = makeFakeOpencodeBin(tmp('session-bin-'));
  const scriptDir = tmp('session-script-');
  const scriptPath = path.join(scriptDir, 'script.json');
  fs.writeFileSync(scriptPath, JSON.stringify(script));
  fs.writeFileSync(path.join(workDir, 'session.json'), typeof input === 'string' ? input : JSON.stringify({
    lane: 'agent_run',
    system_prompt: 'You are the session agent.',
    files: {},
    model: 'anthropic/claude-sonnet-5',
    mcp_servers: [],
    max_tool_calls_per_message: 2,
    ...input,
  }));
  const port = await freePort();
  const base = `http://127.0.0.1:${port}`;
  const child = spawn(process.execPath, [SESSION_JS, path.join(workDir, 'session.json')], {
    env: {
      WORK_DIR: workDir,
      PATH: `${binDir}${path.delimiter}${process.env.PATH}`,
      SESSION_PORT: String(port),
      FAKE_OPENCODE_RECORD_DIR: recordDir,
      FAKE_OPENCODE_SESSION_SCRIPT: scriptPath,
      ...(secret === null ? {} : { SESSION_SECRET: secret }),
      ...(process.env.NODE_V8_COVERAGE ? { NODE_V8_COVERAGE: process.env.NODE_V8_COVERAGE } : {}),
      ...env,
    },
  });
  let stdout = '';
  let stderr = '';
  child.stdout.setEncoding('utf8').on('data', (d) => { stdout += d; });
  child.stderr.setEncoding('utf8').on('data', (d) => { stderr += d; });
  const exited = new Promise((resolve) => child.on('close', (code, signal) => resolve({ code, signal })));
  let exitedYet = false;
  exited.then(() => { exitedYet = true; });

  const headers = (auth) => (auth === null ? {} : { authorization: `Bearer ${auth}` });

  async function request(method, urlPath, body, { auth = secret } = {}) {
    const res = await fetch(base + urlPath, {
      method,
      headers: headers(auth),
      body: body === undefined ? undefined : typeof body === 'string' ? body : JSON.stringify(body),
    });
    const text = await res.text();
    let parsed = text;
    try {
      parsed = text ? JSON.parse(text) : null;
    } catch {
      // A body that is not JSON is returned as text.
    }
    return { status: res.status, body: parsed, contentType: res.headers.get('content-type') };
  }

  /** Events from `from` on, read until `count` events of `untilType` arrived, or the 5 s deadline. */
  async function readEvents(from, untilType, count = 1) {
    return collect(from, (events) => events.filter((e) => e.type === untilType).length >= count, DEADLINE_MS, true);
  }

  /** Whatever events arrive from `from` within `ms`, plus whether the response ended by itself. */
  async function eventsWithin(from, ms) {
    return collect(from, () => false, ms, false);
  }

  async function collect(from, done, ms, failOnDeadline) {
    const ctl = new AbortController();
    const timer = setTimeout(() => ctl.abort(), ms);
    const events = [];
    let ended = false;
    try {
      const res = await fetch(`${base}/events?from=${from}`, { headers: headers(secret), signal: ctl.signal });
      if (res.status !== 200) throw new Error(`GET /events answered ${res.status}: ${await res.text()}`);
      const decoder = new TextDecoder();
      let buffer = '';
      for await (const chunk of res.body) {
        buffer += decoder.decode(chunk, { stream: true });
        let nl;
        while ((nl = buffer.indexOf('\n')) >= 0) {
          const line = buffer.slice(0, nl);
          buffer = buffer.slice(nl + 1);
          if (line) events.push(JSON.parse(line));
        }
        if (done(events)) return events;
      }
      ended = true;
    } catch (e) {
      if (!ctl.signal.aborted) throw e;
      if (failOnDeadline) throw new Error(`events not complete after ${ms}ms: ${JSON.stringify(events)}`);
    } finally {
      clearTimeout(timer);
      ctl.abort();
    }
    if (failOnDeadline && !done(events)) throw new Error(`events ended early: ${JSON.stringify(events)}`);
    return Object.assign(events, { ended });
  }

  async function waitListening() {
    const deadline = Date.now() + DEADLINE_MS;
    while (Date.now() < deadline) {
      try {
        await request('GET', '/healthz');
        return;
      } catch {
        await new Promise((r) => setTimeout(r, 25));
      }
    }
    throw new Error(`session not listening after ${DEADLINE_MS}ms: ${stderr}`);
  }

  async function waitForStderr(pattern) {
    const deadline = Date.now() + DEADLINE_MS;
    while (!pattern.test(stderr)) {
      if (Date.now() >= deadline) throw new Error(`stderr never matched ${pattern}: ${stderr}`);
      await new Promise((r) => setTimeout(r, 25));
    }
  }

  async function waitReady() {
    const deadline = Date.now() + DEADLINE_MS;
    while (Date.now() < deadline) {
      if (exitedYet) throw new Error(`session exited before ready: ${stderr}`);
      try {
        const { status } = await request('GET', '/healthz');
        if (status === 200) return;
      } catch {
        // Not listening yet.
      }
      await new Promise((r) => setTimeout(r, 25));
    }
    throw new Error(`session not ready after ${DEADLINE_MS}ms: ${stderr}`);
  }

  /** What every fake opencode was started with, and the prompt bodies each received. */
  function records() {
    const files = fs.readdirSync(recordDir);
    return files
      .filter((f) => /^\d+\.json$/.test(f))
      .map((f) => {
        const record = JSON.parse(fs.readFileSync(path.join(recordDir, f), 'utf8'));
        const promptsFile = path.join(recordDir, `${record.pid}-prompts.jsonl`);
        const prompts = fs.existsSync(promptsFile)
          ? fs.readFileSync(promptsFile, 'utf8').trim().split('\n').filter(Boolean).map((l) => JSON.parse(l))
          : [];
        return { ...record, prompts };
      });
  }

  async function cleanup() {
    if (!exitedYet) {
      child.kill('SIGTERM');
      const killer = setTimeout(() => child.kill('SIGKILL'), 5_000);
      await exited;
      clearTimeout(killer);
    }
    for (const r of records()) {
      try {
        process.kill(r.pid, 'SIGKILL');
      } catch {
        // Already gone.
      }
    }
    for (const d of [workDir, recordDir, binDir, scriptDir]) fs.rmSync(d, { recursive: true, force: true });
  }

  return {
    base,
    port,
    secret,
    workDir,
    child,
    exited,
    request,
    readEvents,
    eventsWithin,
    waitListening,
    waitReady,
    waitForStderr,
    records,
    stdout: () => stdout,
    stderr: () => stderr,
    cleanup,
  };
}

module.exports = { startSession };
