'use strict';
/*
 * Starting the REAL server.js as a child process and talking to it, shared by the launcher tests.
 * No extension, so node --test skips it.
 */
const assert = require('node:assert/strict');
const http = require('node:http');
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const net = require('node:net');
const { spawn } = require('node:child_process');

const SERVER_JS = path.join(__dirname, '..', '..', 'server.js');

function spawnLauncher(env) {
  return spawn('node', [SERVER_JS], { env: { ...process.env, ...env, PORT: '0' }, stdio: ['ignore', 'pipe', 'pipe'] });
}

// PORT=0 hands the choice to the OS and the launcher logs back the port it actually bound, so
// tests can never collide on a guessed one. Returns that port alongside the child.
async function startLauncher(env) {
  const child = spawnLauncher(env);
  let timer;
  const port = await new Promise((resolve, reject) => {
    let out = '';
    const onData = (d) => {
      out += d.toString();
      const bound = /listening on :(\d+)/.exec(out);
      if (bound) { child.stdout.off('data', onData); resolve(Number(bound[1])); }
    };
    child.stdout.on('data', onData);
    child.stderr.on('data', (d) => { out += d.toString(); });
    child.on('exit', (code) => reject(new Error(`launcher exited early (code ${code}): ${out}`)));
    timer = setTimeout(() => reject(new Error(`launcher did not start in time: ${out}`)), 5000);
  }).finally(() => clearTimeout(timer));
  return { child, port };
}

function postJson(port, urlPath, body, apiKey) {
  return new Promise((resolve, reject) => {
    const data = Buffer.from(JSON.stringify(body));
    const req = http.request(
      { host: '127.0.0.1', port, path: urlPath, method: 'POST', headers: { 'Content-Type': 'application/json', 'Content-Length': data.length, Authorization: `Bearer ${apiKey}` } },
      (res) => {
        const chunks = [];
        res.on('data', (c) => chunks.push(c));
        res.on('end', () => resolve({ status: res.statusCode, body: Buffer.concat(chunks).toString('utf8') }));
      },
    );
    req.on('error', reject);
    req.write(data);
    req.end();
  });
}

/** One request to the launcher; `body` is the parsed JSON answer, or undefined when it has none. */
function request(port, method, urlPath, { body, auth } = {}) {
  return new Promise((resolve, reject) => {
    const headers = { 'Content-Type': 'application/json' };
    if (auth) headers.Authorization = auth;
    const req = http.request({ host: '127.0.0.1', port, path: urlPath, method, headers }, (res) => {
      const chunks = [];
      res.on('data', (c) => chunks.push(c));
      res.on('end', () => {
        const text = Buffer.concat(chunks).toString('utf8');
        resolve({ status: res.statusCode, body: text ? JSON.parse(text) : undefined });
      });
    });
    req.on('error', reject);
    req.end(body === undefined ? undefined : JSON.stringify(body));
  });
}

/**
 * Reads GET /sessions/{id}/events as server-sent events. Resolves when the stream ends, or once an
 * event with id `until` or later arrives (the reader then hangs up). `events` is
 * `[{ id, type, data }]`; `times[i]` is when `events[i]` arrived. A non-200 answer resolves to
 * `{ status, body }`.
 */
function readSse(port, id, { after, until, timeoutMs = 5000, auth = 'Bearer testkey' } = {}) {
  return new Promise((resolve, reject) => {
    const events = [];
    const times = [];
    const query = after === undefined ? '' : `?after=${encodeURIComponent(after)}`;
    let settled = false;
    let req;
    const timer = setTimeout(() => {
      settled = true;
      req.destroy();
      reject(new Error(`timed out reading the events of ${id}: got ${JSON.stringify(events)}`));
    }, timeoutMs);
    const finish = (value) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      resolve(value);
    };
    req = http.request({ host: '127.0.0.1', port, path: `/sessions/${id}/events${query}`, method: 'GET', headers: { Authorization: auth } }, (res) => {
      if (res.statusCode !== 200) {
        const chunks = [];
        res.on('data', (c) => chunks.push(c));
        res.on('end', () => {
          const text = Buffer.concat(chunks).toString('utf8');
          finish({ status: res.statusCode, body: text ? JSON.parse(text) : undefined });
        });
        return;
      }
      let buffered = '';
      res.setEncoding('utf8');
      res.on('data', (chunk) => {
        buffered += chunk;
        let cut;
        while ((cut = buffered.indexOf('\n\n')) !== -1) {
          const frame = buffered.slice(0, cut);
          buffered = buffered.slice(cut + 2);
          const fields = {};
          for (const line of frame.split('\n')) {
            const colon = line.indexOf(': ');
            fields[line.slice(0, colon)] = line.slice(colon + 2);
          }
          events.push({ id: Number(fields.id), type: fields.event, data: JSON.parse(fields.data) });
          times.push(Date.now());
          if (until !== undefined && Number(fields.id) >= until) {
            finish({ status: 200, events, times, ended: false });
            req.destroy();
            return;
          }
        }
      });
      res.on('end', () => finish({ status: 200, events, times, ended: true }));
      res.on('error', () => finish({ status: 200, events, times, ended: false }));
    });
    req.on('error', (e) => { if (!settled) { settled = true; clearTimeout(timer); reject(e); } });
    req.end();
  });
}

/** A TCP port free on 127.0.0.1 at the time of the call. */
function freePort() {
  return new Promise((resolve, reject) => {
    const srv = net.createServer();
    srv.once('error', reject);
    srv.listen(0, '127.0.0.1', () => {
      const { port } = srv.address();
      srv.close(() => resolve(port));
    });
  });
}

function tempDir(prefix) {
  return fs.mkdtempSync(path.join(os.tmpdir(), prefix));
}

// The per-run timing is the only field that varies; everything else in the body is pinned.
function withoutElapsed(body) {
  assert.equal(typeof body.elapsed_ms, 'number');
  const { elapsed_ms: _elapsed, ...rest } = body;
  return rest;
}

/** The fake session's fixed reply to message `n` with `text` (fixtures/fake-session's playReply). */
function reply(n, text) {
  return [
    { type: 'text', data: { delta: `echo:${text}` } },
    { type: 'tool_start', data: { call_id: `call-${n}`, server: 'tessary', tool: 'get_trace', input_summary: '{}' } },
    { type: 'tool_end', data: { call_id: `call-${n}`, result_summary: 'ok', bytes: 2, duration_ms: 5, ok: true } },
    {
      type: 'message_end',
      data: { usage: { input_tokens: 10, output_tokens: 5, cache_read_input_tokens: 0, cache_creation_input_tokens: 0, cost_usd: 0.001 }, reason: 'done' },
    },
  ];
}

function numbered(events, firstId) {
  return events.map((e, i) => ({ id: firstId + i, ...e }));
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function until(condition, what) {
  const deadline = Date.now() + 5000;
  while (!condition()) {
    assert.ok(Date.now() < deadline, `timed out waiting for ${what}`);
    await sleep(10);
  }
}

module.exports = { spawnLauncher, startLauncher, postJson, request, readSse, freePort, tempDir, withoutElapsed, reply, numbered, sleep, until };
